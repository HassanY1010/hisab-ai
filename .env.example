# =====================================================================
# HISAB AI: Production & Cloud Environment Configuration
# =====================================================================

# Server Configuration
PORT=4000
NODE_ENV=production
ALLOWED_ORIGIN="*"

# PostgreSQL / Supabase Database Connection
# Use Supabase Connection Pooler (Port 6543) for Transaction Mode in Serverless/Cloud
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL for Prisma migrations and schema push (Port 5432)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Storage Configuration (For persistent cloud receipt images)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJh..."
SUPABASE_ANON_KEY="eyJh..."
SUPABASE_STORAGE_BUCKET="receipts"

# Frontend API URL (Set only if frontend is hosted on a separate domain from backend)
# If frontend is served directly by the backend Express server, leave empty or unset.
VITE_API_URL=""
